# OPTIONAL TEMPLATE FOR A FUTURE BACKEND.
# The current GitHub Pages demo is browser-only and does NOT read this file.
# This file contains examples/placeholders only. Never paste real credentials here.
# Copy this file to .env on your own computer, then replace values locally.
# Keep .env untracked: the repository .gitignore excludes it.

# Local development server (example values)
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ALLOWED_ORIGINS=http://127.0.0.1:8000

# Optional public occupational taxonomy source.
# ESCO offers public classification access; check its current API documentation.
ESCO_API_BASE_URL=https://ec.europa.eu/esco/api
ESCO_LANGUAGE=en

# Optional third-party job provider.
# Replace the example.invalid URL with the provider endpoint you choose.
# Obtain an API key from that provider's official developer portal, if required.
JOBS_API_BASE_URL=https://example.invalid/api
JOBS_API_KEY=REPLACE_WITH_YOUR_OWN_KEY_IF_REQUIRED

# Optional database for a future backend.
# This is a fake local example, not a real connection string.
DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/remote_job_fit

# Generate a strong random secret locally if the backend later requires one.
# Do not use this placeholder as a real secret.
APP_SECRET=GENERATE_A_UNIQUE_RANDOM_SECRET_LOCALLY
